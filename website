            width: 100%; 
        } 
         
        .section-title { 
            position: relative; 
            display: inline-block; 
        } 
         
        .section-title::after { 
            content: ''; 
            position: absolute; 
            width: 60px; 
            height: 3px; 
            background-color: var(--secondary-color); 
            bottom: -10px; 
            left: 50%; 
            transform: translateX(-50%); 
